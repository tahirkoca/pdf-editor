<UserControl x:Class="PdfEditor.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:PdfEditor.Views"
             Focusable="True"
             PreviewKeyDown="View_PreviewKeyDown">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type local:GroupHeader}">
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="2,14,0,4" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:CandidateItem}">
            <Border Padding="8,6" Margin="0,2" CornerRadius="6" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="BorderBrush" Value="#E11D48" />
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" MinWidth="0" Margin="0,0,4,0"
                              VerticalAlignment="Top" Click="Candidate_Changed" />
                    <StackPanel Grid.Column="1" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Candidate_Focus">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding ConfidenceText}" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid Margin="0,6,0,0" Visibility="{Binding ReplacementVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Yerine:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:TextBox Grid.Column="1" PlaceholderText="Boş bırakılırsa yazı silinir"
                                        Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}"
                                        TextChanged="Replacement_Changed" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sol: kaynak, bulunanlar, metin değiştir -->
        <Grid Grid.Column="0" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="PDF kaynağı" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="PDF dosyasını veya klasörü buraya sürükleyebilirsiniz" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="PDF Aç" Click="OpenFile_Click" Margin="0,0,8,0" />
                        <ui:Button Content="Klasör Aç" Click="OpenFolder_Click" />
                    </StackPanel>
                    <TextBlock x:Name="FileNameText" Margin="0,10,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <ComboBox x:Name="FileComboBox" Margin="0,8,0,0" Visibility="Collapsed" SelectionChanged="FileComboBox_SelectionChanged" />
                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Row="1" Padding="16,12" Margin="0,0,0,12" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Bulunanlar" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="İşaretli olanlar silinir. Bir satıra tıklayınca önizlemede kırmızı çerçeveyle gösterilir." />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Watermark ya da tekrarlanan öğe bulunamadı. Taranmış PDF'lerde watermark sayfa görüntüsünün parçası olabilir; bu durumda silinemez. Aşağıdan metin bul / değiştir kullanılabilir." />
                            <ItemsControl x:Name="CandidateList" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="2" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Metin bul / değiştir" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="FindTextBox" PlaceholderText="Bul" />
                        <ui:TextBox x:Name="ReplaceTextBox" Grid.Column="2" PlaceholderText="Yerine (boş: sil)" />
                        <ui:Button Grid.Column="3" Content="Ekle" Margin="8,0,0,0" Click="AddReplacement_Click" />
                    </Grid>
                    <ListBox x:Name="ReplacementList" DisplayMemberPath="Display" MaxHeight="96" Margin="0,8,0,0" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Font:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:TextBox x:Name="FontTextBox" Grid.Column="1" PlaceholderText="Varsayılan: Arial" TextChanged="Font_Changed" />
                        <ui:Button Grid.Column="2" Content="Seç" Margin="8,0,0,0" Click="ChooseFont_Click" />
                        <ui:Button Grid.Column="3" Content="Kaldır" Margin="8,0,0,0" Click="RemoveReplacement_Click"
                                   ToolTip="Listede seçili değişikliği kaldırır" />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </Grid>

        <!-- Sağ: önizleme -->
        <Grid Grid.Column="2" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ui:Button Content="◀" Width="40" Click="PrevPage_Click" />
                <TextBlock x:Name="PageText" Width="120" TextAlignment="Center" VerticalAlignment="Center" />
                <ui:Button Content="▶" Width="40" Click="NextPage_Click" />
                <RadioButton x:Name="BeforeRadio" Content="Önce" IsChecked="True" Margin="24,0,0,0" Checked="View_Checked" />
                <RadioButton x:Name="AfterRadio" Content="Sonra (önizleme)" Margin="8,0,0,0" Checked="View_Checked" />
            </StackPanel>
            <Border Grid.Row="1" CornerRadius="8" Padding="12" Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="PageGrid" Width="595" Height="842">
                            <Image x:Name="PageImage" Stretch="Fill" />
                            <Canvas x:Name="Overlay" IsHitTestVisible="False" />
                        </Grid>
                    </Viewbox>
                    <TextBlock x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"
                               Text="PDF dosyasını buraya sürükleyin ya da &quot;PDF Aç&quot; ile seçin." />
                </Grid>
            </Border>
        </Grid>

        <!-- Alt çubuk -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <ui:InfoBar x:Name="MessageInfoBar" IsOpen="False" IsClosable="True" Title="Bilgi" Message="" Severity="Informational" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Width="120" Height="6" Margin="0,0,12,0" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <ui:Button x:Name="SaveFolderButton" Grid.Column="1" Content="Klasördeki tüm PDF'lere uygula" Margin="0,0,8,0"
                       VerticalAlignment="Bottom" IsEnabled="False" Click="SaveFolder_Click" />
            <ui:Button x:Name="SaveButton" Grid.Column="2" Content="Kaydet" Appearance="Primary" MinWidth="120"
                       VerticalAlignment="Bottom" IsEnabled="False" Click="Save_Click" />
        </Grid>
    </Grid>
</UserControl>
